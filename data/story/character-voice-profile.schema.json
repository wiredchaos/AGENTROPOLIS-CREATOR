{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.local/schemas/story/character-voice-profile.schema.json",
  "title": "Immutable Character Voice Profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["production_contract_version", "character_id", "voice_profile", "voice_version", "source", "review_state"],
  "properties": {
    "production_contract_version": { "const": "1.0.0" },
    "character_id": { "type": "string", "minLength": 1 },
    "voice_profile": { "type": "string", "minLength": 1 },
    "voice_version": { "type": "string", "pattern": "^v[1-9][0-9]*$" },
    "source": {
      "type": "object",
      "additionalProperties": true,
      "required": ["kind", "id"],
      "properties": {
        "kind": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 }
      }
    },
    "review_state": { "enum": ["APPROVED", "REQUIRES_REVIEW"] }
  }
}
