{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.local/schemas/story/scene-requirements.schema.json",
  "title": "Story Scene Existing-Asset Matcher Request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "scene_id", "required_characters", "required_factions", "world", "era",
    "location", "studio_mode", "visual_style", "camera_language", "action",
    "mood", "canon_status_requirement", "output_use", "selection_mode",
    "identity_requirements", "rights_requirement", "continuity_tags"
  ],
  "properties": {
    "scene_id": { "type": "string", "minLength": 1 },
    "required_characters": { "$ref": "#/$defs/stringArray" },
    "required_factions": { "$ref": "#/$defs/stringArray" },
    "world": { "type": "string", "minLength": 1 },
    "era": { "type": "string", "minLength": 1 },
    "location": { "type": "string", "minLength": 1 },
    "studio_mode": {
      "enum": ["789_STUDIOS", "NTRU_STUDIOS", "GRINDER_NEURO_TOKYO_2090", "ATVNETWORK_INTERFACE", "UNASSIGNED"]
    },
    "visual_style": { "type": "string" },
    "camera_language": { "type": "string" },
    "action": { "type": "string" },
    "mood": { "type": "string" },
    "canon_status_requirement": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/canonStatus" },
      "uniqueItems": true
    },
    "output_use": {
      "enum": ["INTERACTIVE_BRANCH", "ATV_EPISODE", "KOL_SOCIAL", "GAMING_DISTRICT"]
    },
    "selection_mode": { "enum": ["REVIEW_SEARCH", "FINAL_PRODUCTION", "FIXTURE_TEST"] },
    "identity_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_character_ids", "canonical_faction_ids",
        "canonical_artifact_ids", "continuity_locked_identity_ids"
      ],
      "properties": {
        "canonical_character_ids": { "$ref": "#/$defs/stringArray" },
        "canonical_faction_ids": { "$ref": "#/$defs/stringArray" },
        "canonical_artifact_ids": { "$ref": "#/$defs/stringArray" },
        "continuity_locked_identity_ids": { "$ref": "#/$defs/stringArray" }
      }
    },
    "rights_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["production_use", "derivative_edit_required", "distribution_required"],
      "properties": {
        "production_use": { "enum": ["EDITORIAL_REVIEW", "FILM_MASTER", "INTERACTIVE_BRANCH", "ATV_EPISODE", "KOL_SOCIAL", "GAMING_DISTRICT"] },
        "derivative_edit_required": { "type": "boolean" },
        "distribution_required": { "type": "boolean" }
      }
    },
    "continuity_tags": { "$ref": "#/$defs/stringArray" },
    "required_continuity_tags": { "$ref": "#/$defs/stringArray" },
    "forbidden_continuity_tags": { "$ref": "#/$defs/stringArray" },
    "duration_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_seconds", "target_seconds", "maximum_seconds", "segment_allowed"],
      "properties": {
        "minimum_seconds": { "type": "number", "minimum": 0 },
        "target_seconds": { "type": "number", "minimum": 0 },
        "maximum_seconds": { "type": "number", "minimum": 0 },
        "segment_allowed": { "type": "boolean" }
      }
    },
    "truth_states_allowed": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["SOURCE_VERIFIED", "AUTHOR_DECLARED", "PROVISIONAL", "CONTESTED", "METAVERSE_SYNTHESIS", "CANON_GAP", "UNREVIEWED"]
      },
      "uniqueItems": true
    },
    "audio_requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "exact_dialogue", "speaker_ids", "rights_approval_required"],
      "properties": {
        "mode": { "enum": ["REQUIRED", "OPTIONAL", "PROHIBITED", "REPLACEABLE_IN_EDIT"] },
        "exact_dialogue": { "type": ["string", "null"] },
        "speaker_ids": { "$ref": "#/$defs/stringArray" },
        "rights_approval_required": { "type": "boolean" }
      }
    },
    "required_production_role": { "$ref": "#/$defs/productionRole" },
    "required_local_character_family": { "type": "string", "minLength": 1 },
    "required_variant_labels": { "$ref": "#/$defs/stringArray" },
    "preferred_variant_labels": { "$ref": "#/$defs/stringArray" },
    "forbidden_variant_labels": { "$ref": "#/$defs/stringArray" },
    "required_reference_tags": { "$ref": "#/$defs/stringArray" },
    "required_local_location_labels": { "$ref": "#/$defs/stringArray" },
    "required_local_prop_labels": { "$ref": "#/$defs/stringArray" },
    "required_local_mech_labels": { "$ref": "#/$defs/stringArray" },
    "required_local_creature_labels": { "$ref": "#/$defs/stringArray" },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reviewSlot" }
    }
  },
  "$defs": {
    "productionRole": {
      "enum": ["CHARACTER", "CHARACTER_STATE", "CHARACTER_SHEET", "MECH", "LOCATION", "PROP", "CREATURE", "OTHER"]
    },
    "reviewSlot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "$ref": "#/$defs/productionRole" },
        "local_character_family": { "type": "string", "minLength": 1 },
        "variant_labels": { "$ref": "#/$defs/stringArray" },
        "preferred_variant_labels": { "$ref": "#/$defs/stringArray" },
        "forbidden_variant_labels": { "$ref": "#/$defs/stringArray" },
        "reference_tags": { "$ref": "#/$defs/stringArray" },
        "local_location_labels": { "$ref": "#/$defs/stringArray" },
        "local_prop_labels": { "$ref": "#/$defs/stringArray" },
        "local_mech_labels": { "$ref": "#/$defs/stringArray" },
        "local_creature_labels": { "$ref": "#/$defs/stringArray" },
        "count": { "type": "integer", "minimum": 1 },
        "distinct_local_character_families": { "type": "boolean" },
        "allow_asset_reuse": { "type": "boolean" },
        "compatible_character_slot_ids": { "$ref": "#/$defs/stringArray" },
        "distinct_from_slot_ids": { "$ref": "#/$defs/stringArray" }
      }
    },
    "canonStatus": {
      "enum": ["SOURCE_CANON", "AUTHOR_DECLARED_CANON", "PROVISIONAL_CANON", "CONTESTED_CANON", "METAVERSE_SYNTHESIS", "CANON_GAP"]
    },
    "stringArray": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    }
  }
}
