{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentropolis.film/schemas/creative-package.schema.json",
  "title": "AGENTROPOLIS-CREATOR Creative Package",
  "description": "The CREATOR-owned native creative package. Version-addressable refs point at canonical prompt packages, visual canon, shot plans, storyboards, and campaigns. The creative-package adapter converts this format to the FILM DISTRICT bridge contract (contracts/creator-to-asbe.schema.json). Draft 2020-12.",
  "type": "object",
  "required": [
    "package_id",
    "package_version",
    "brief_id",
    "route",
    "campaign_ref",
    "prompt_package_ref",
    "visual_canon_ref",
    "spec",
    "beats",
    "copy",
    "technique",
    "negatives",
    "continuity_bible",
    "shot_plan_ref",
    "storyboard_refs",
    "asset_hashes",
    "distribution_targets"
  ],
  "properties": {
    "package_id": { "type": "string", "minLength": 1 },
    "package_version": { "type": "string", "minLength": 1 },
    "brief_id": { "type": "string", "minLength": 1 },
    "route": { "type": "string", "minLength": 1 },
    "campaign_ref": { "$ref": "#/$defs/versionedRef" },
    "prompt_package_ref": {
      "type": "object",
      "required": ["id", "version", "canonical_content_hash"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "canonical_content_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      },
      "additionalProperties": false
    },
    "visual_canon_ref": { "$ref": "#/$defs/versionedRef" },
    "spec": {
      "type": "object",
      "required": ["duration_seconds", "aspect_ratio", "fps", "resolution", "platform", "delivery_format"],
      "properties": {
        "duration_seconds": { "type": "number", "minimum": 1 },
        "aspect_ratio": { "type": "string" },
        "resolution": { "type": "string" },
        "fps": { "type": "number" },
        "platform": { "type": "string" },
        "delivery_format": { "type": "string" }
      }
    },
    "beats": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["time", "description"],
        "properties": {
          "time": { "type": "string" },
          "description": { "type": "string" },
          "visual": { "type": "string" },
          "audio": { "type": "string" }
        }
      }
    },
    "copy": { "type": "string", "minLength": 1 },
    "technique": { "type": "string", "minLength": 1 },
    "negatives": { "type": "string", "minLength": 1 },
    "negative_constraints_ref": { "type": "string", "description": "Relative path to the binding negative-constraints file." },
    "continuity_bible": {
      "type": "object",
      "properties": {
        "characters": { "type": "object", "additionalProperties": true },
        "locations": { "type": "object", "additionalProperties": true },
        "props": { "type": "object", "additionalProperties": true },
        "style_rules": { "type": "array", "items": { "type": "string" } },
        "never_change": { "type": "array", "items": { "type": "string" } }
      }
    },
    "shot_plan_ref": { "$ref": "#/$defs/versionedRef" },
    "storyboard_refs": { "type": "array", "items": { "$ref": "#/$defs/versionedRef" } },
    "asset_hashes": {
      "type": "object",
      "description": "SHA-256 of every input source asset keyed by path. Empty when all content is generated originals.",
      "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "distribution_targets": { "type": "array", "items": { "type": "string" } },
    "asbe_scene_ref": { "type": "string" },
    "asbe_shot_ref": { "type": "string" }
  },
  "additionalProperties": true,
  "$defs": {
    "versionedRef": {
      "type": "object",
      "required": ["id", "version"],
      "properties": { "id": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    }
  }
}
