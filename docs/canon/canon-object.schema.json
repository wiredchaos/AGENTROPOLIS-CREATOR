{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentropolis://creator/canon-object/v1",
  "title": "CREATOR Canon Object",
  "type": "object",
  "required": ["id", "namespace", "claim", "canon_state", "provenance"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "namespace": {
      "type": "string",
      "enum": ["NTRU", "CHRYSANTHEUM", "GRINDER", "BLAQ_TIARAS", "COINT3LPRO", "PURGE_FACTOR", "AGENTROPOLIS", "TARATIA_589"]
    },
    "claim": { "type": "string", "minLength": 1 },
    "canon_state": {
      "type": "string",
      "enum": ["REPO_BACKED", "AUTHOR_DECLARED", "DISPUTED", "PROVISIONAL"]
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_type", "source"],
        "properties": {
          "source_type": { "type": "string", "enum": ["repository", "author", "wikivault", "artifact"] },
          "source": { "type": "string" },
          "ref": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "conflicts_with": { "type": "array", "items": { "type": "string" } },
    "cross_property_refs": { "type": "array", "items": { "type": "string" } },
    "promotion_requires_review": { "type": "boolean", "default": true }
  },
  "additionalProperties": false
}
