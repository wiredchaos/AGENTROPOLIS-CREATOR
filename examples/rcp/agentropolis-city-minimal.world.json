      "id": "law.civic-corridor",
      "generator": "agentropolis.civic-corridor",
      "generator_version": "0.1.0",
      "seed_policy": "package-id-hash",
      "reproducibility": "equivalent",
      "inputs": {
        "width_meters": 8,
        "pedestrian_priority": true
      },
      "invariants": [
        "identity-plaza-remains-reachable",
        "mission-control-boundary-remains-visible"
      ],
      "mutation_permissions": ["street-furniture", "lighting", "landscaping"],
      "output_domain": "public-corridor"
    }
  ],
  "geometry_contract": {
    "layers": ["render", "collision", "navigation", "occlusion", "interaction", "semantic"],
    "objects": [
      {
        "id": "geometry.identity-plaza",
        "entity_ref": "place.identity-plaza",
        "layers": ["render", "collision", "navigation", "interaction", "semantic"],
        "affordances": ["enter", "inspect-identity", "request-mandate"],
        "authority_requirements": ["public-entry", "mandate-required-for-mutation"],
        "memory_policy": "receipt-references-only",
        "provenance_ref": "agentropolis-core-canon"
      }
    ],
    "budgets": {
      "target_fps": 60,
      "maximum_initial_download_mb": 25
    }
  },
  "runtime_bindings": {
    "targets": ["threejs-webgpu", "static-preview"],
    "events": [
      {
        "event": "request-mandate",
        "trigger": {
          "zone": "geometry.identity-plaza"
        },
        "effect": {
          "route": "mission-control-mandate-intake"
        },
        "authority_scope": "proposal-only"
      }
    ],
    "capabilities": ["walk", "inspect", "request-mandate"],
    "adapters": ["rcp-threejs-preview"]
  },
  "governance": {
    "human_review_required": true,
    "permissions": [
      {
        "subject": "public",
        "action": "enter",
        "resource": "place.identity-plaza",
        "decision": "allow"
      },
      {
        "subject": "agent",
        "action": "modify",
        "resource": "world",
        "decision": "approval_required"
      }
    ],
    "prohibited_actions": ["self-approve-release", "live-settlement", "physical-actuation"],
    "privacy_class": "public",
    "physical_actuation": "none",
    "cost_budget": {
      "compile_usd": 10,
      "runtime_hourly_usd": 1
    }
  },
  "audit_contract": {
    "profile": "rcp-baseline-0.1",
    "tests": [
      {
        "id": "schema-valid",
        "category": "schema",
        "required": true,
        "procedure": "Validate against schemas/rcp/world-package.schema.json",
        "threshold": true
      },
      {
        "id": "required-places-reachable",
        "category": "navigation",
        "required": true,
        "procedure": "Traverse all required place nodes from the public spawn.",
        "threshold": 1
      },
      {
        "id": "authority-boundary",
        "category": "governance",
        "required": true,
        "procedure": "Attempt world mutation without approval and verify denial.",
        "threshold": true
      }
    ],
    "release_thresholds": {
      "required_tests_pass": true,
      "critical_failures": 0,
      "human_approval": true
    }
  },
  "receipts": []
